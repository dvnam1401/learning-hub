# === BẮT BUỘC (local + production) ===
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-32-ky-tu

# === LOCAL DEV (mặc định dùng SQLite data/app.db — KHÔNG cần Cloudflare) ===
# Chỉ cần JWT_SECRET + GOOGLE_* nếu muốn xem video.
# Sau khi đổi Node.js: chạy npm rebuild better-sqlite3

# === GOOGLE DRIVE — Service Account (khuyến nghị production) ===
# Tạo SA trên Google Cloud → bật Drive API → tải key JSON
# Thêm SA vào Shared Drive chứa video (Manage members → Viewer trở lên)
# Cách 1 — email + private key (Vercel / .env.local):
GOOGLE_SERVICE_ACCOUNT_EMAIL=learning-hub@corded-backbone-392808.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Cách 2 — đường dẫn file JSON (chỉ local, không commit):
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=secrets/google-service-account.json
# Cách 3 — cả JSON một dòng (Vercel):
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Tùy chọn — Domain-Wide Delegation (Google Workspace admin):
# GOOGLE_SERVICE_ACCOUNT_SUBJECT=owner@congty.com

# === GOOGLE DRIVE — OAuth (fallback dev local) ===
# Lấy từ drive_scaner/credentials.json + token.json
# Nếu gặp invalid_grant: chạy npm run auth:google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# === CLOUDFLARE D1 — CHỈ khi deploy production (Vercel), bỏ trống khi dev local ===
# Tạo D1 trên Cloudflare Dashboard → lấy database_id
# API Token: quyền Account → D1 → Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# === Build catalog (npm run build:catalog) ===
DRIVE_NDJSON_PATH=../drive_scaner/output/drive.ndjson
